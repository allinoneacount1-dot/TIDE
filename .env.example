# ─────────────────────────────────────────────────────────────────────────────
# TIDE — repository-level environment
#
# The frontend has its own: frontend/.env.example
# The keeper has its own:   keeper/.env.example
#
# This file is for the contracts package only.
# ─────────────────────────────────────────────────────────────────────────────

# RPC endpoints used by `forge script` and the foundry.toml [rpc_endpoints] block.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Deployment configuration. All optional — each defaults to the deployer address,
# except the fee which defaults to 15 bps and is capped at 50 by the contract.
TIDE_TREASURY=
TIDE_KEEPER=
TIDE_FEE_BPS=15

# Blockscout accepts any non-empty value for verification.
BLOCKSCOUT_API_KEY=blockscout

# NOTE: there is deliberately no PRIVATE_KEY here.
# Deploy with a keystore instead — a key in a dotfile is one `cat` away from a
# screen share:
#
#   cast wallet import tide-deployer --interactive
#   forge script ... --account tide-deployer
