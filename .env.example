# .env.example — TIDE
# Copy to .env and fill

# --- RPC ---
NEXT_PUBLIC_ROBINHOOD_L2_RPC=https://robinhood-l2.example.rpc
NEXT_PUBLIC_ROBINHOOD_L2_CHAIN_ID=97468
NEXT_PUBLIC_ROBINHOOD_L2_EXPLORER=https://explorer.robinhood-chain.com
ALCHEMY_API_KEY=
INFURA_API_KEY=

# --- CONTRACTS (fill after deploy) ---
NEXT_PUBLIC_VAULT_FACTORY_ADDRESS=0x...
NEXT_PUBLIC_USDC_ADDRESS=0x...
NEXT_PUBLIC_AAPLx_ADDRESS=0x...
NEXT_PUBLIC_AGGREGATOR_ADDRESS=0x...

# --- PRICE / QUOTE (free tier, no key needed for Pyth) ---
NEXT_PUBLIC_PYTH_HERMES=https://hermes.pyth.network
ZEROX_API_URL=https://api.0x.org

# --- SUPABASE (free tier) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- UPSTASH REDIS (free tier) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- AUTOMATION ---
GELATO_API_KEY=
# or CHAINLINK_AUTOMATION — pick one

# --- NOTIFICATIONS (optional) ---
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=

# --- DEPLOY ---
PRIVATE_KEY=0x...
