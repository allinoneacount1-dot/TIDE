{
  "name": "tide-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/sync-contracts.mjs --if-available",
    "build": "next build",
    "prebuild": "node scripts/sync-contracts.mjs --if-available",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "sync:contracts": "node scripts/sync-contracts.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.2",
    "gsap": "^3.15.0",
    "lightweight-charts": "^5.2.1",
    "next": "15.5.9",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "viem": "^2.55.19",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.9",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.22.0"
}
