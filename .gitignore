node_modules
.pnpm-store
.DS_Store

# contracts
contracts/out
contracts/cache
contracts/broadcast
contracts/.env

# Deployment records are per-environment: `forge script` writes them, and
# committing a devnet record would ship Anvil's deterministic addresses as
# though they were a real deployment. Hosted builds use NEXT_PUBLIC_TIDE_*.
contracts/deployments/*.json

# The generated frontend files ARE committed. Hosts that build only `frontend/`
# — Vercel, Netlify, a Docker stage — have no Foundry, so they cannot regenerate
# them and the build would fail on a missing module. `pnpm sync:contracts`
# refreshes them whenever the contracts are rebuilt locally.

# frontend
frontend/.next
frontend/out
frontend/.env
frontend/.env.local
frontend/test-results
frontend/playwright-report
frontend/tsconfig.tsbuildinfo
frontend/next-env.d.ts

# keeper
keeper/.env
keeper/.env.local

# secrets, anywhere
.env
*.pem
*.key
