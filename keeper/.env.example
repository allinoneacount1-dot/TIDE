# TIDE keeper — copy to .env

# Chain
RPC_URL=https://rpc.testnet.chain.robinhood.com
CHAIN_ID=46630
REGISTRY_ADDRESS=

# Hot key. Fund with gas only. A leak here is a DoS, not a loss of funds:
# the keeper cannot withdraw, cannot edit plans, and cannot execute below the
# vault's own on-chain price floor.
KEEPER_PRIVATE_KEY=

# Required on mainnet (4663) to fetch swap routes. Not used on simulated chains.
ZEROX_API_KEY=

# Behaviour
POLL_SECONDS=60
MAX_GAS_GWEI=5

# Optional allowlist. Empty = every vault the registry has created.
VAULTS=
